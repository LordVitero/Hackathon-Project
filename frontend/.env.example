# Empty = clearly labeled local demo; no photos are sent to a server.
NEXT_PUBLIC_API_BASE_URL=/api
# Real cropped photo of the green 3D-printed Lenny dragon, e.g. /lenny-reference.jpg
NEXT_PUBLIC_LENNY_REFERENCE_URL=
# Optional: computer Wi-Fi IP/hostname for phone testing, without scheme or port.
# Multiple hostnames can be comma-separated. Only affects the development server.
LENNY_DEV_ALLOWED_ORIGINS=
